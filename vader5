#!/usr/bin/env bash
set -euo pipefail

RULE=/etc/udev/rules.d/60-vader5-sdl.rules
DRIVER_DIR="${VADER5_DRIVER_DIR:-$HOME/.local/share/vader5-driver/sdl}"
STEAM_DIR="${VADER5_STEAM_DIR:-$HOME/.local/share/Steam}"

IS_RU=false
if [[ "${LANG:-}" =~ ^ru || "${LC_ALL:-}" =~ ^ru || "${LC_MESSAGES:-}" =~ ^ru ]]; then
    IS_RU=true
fi

reload_udev() {
    if [[ -f "$DRIVER_DIR/60-vader5-sdl.rules" ]] && ! cmp -s "$DRIVER_DIR/60-vader5-sdl.rules" "$RULE"; then
        sudo install -m 0644 "$DRIVER_DIR/60-vader5-sdl.rules" "$RULE"
    fi
    sudo udevadm control --reload-rules
    local usb
    for usb in /sys/bus/usb/devices/*; do
        [[ -f "$usb/idVendor" && -f "$usb/idProduct" ]] || continue
        if [[ "$(cat "$usb/idVendor")" == 37d7 && "$(cat "$usb/idProduct")" == 2401 ]]; then
            sudo udevadm trigger --action=add "$usb"
        fi
    done
    local interface parent
    for interface in /sys/bus/usb/drivers/xpad/*:1.0; do
        [[ -L "$interface" ]] || continue
        parent=$(dirname "$(readlink -f "$interface")")
        if [[ "$(cat "$parent/idVendor" 2>/dev/null)" == 37d7 && "$(cat "$parent/idProduct" 2>/dev/null)" == 2401 ]]; then
            printf '%s' "${interface##*/}" | sudo tee /sys/bus/usb/drivers/xpad/unbind >/dev/null
        fi
    done
}

patch_one() {
    local arch="$1" directory="$2" source target shim shim_source original state backup_dir
    source="$DRIVER_DIR/libSDL3-$arch.so.0"
    target="$STEAM_DIR/$directory/libSDL3.so.0"
    shim="$STEAM_DIR/$directory/sdl3_shim.so"
    shim_source="$DRIVER_DIR/sdl3_shim${arch}.so"
    [[ -f "$target" && -f "$source" && -f "$shim_source" ]] || return 0

    local old_size new_size current_hash
    backup_dir="$DRIVER_DIR/originals/$directory"
    original="$backup_dir/libSDL3.so.0"
    state="$DRIVER_DIR/$directory.last-patch.sha256"
    current_hash=$(sha256sum "$target")
    current_hash=${current_hash%% *}
    if [[ ! -f "$original" || ( -f "$state" && "$current_hash" != "$(cat "$state")" ) ]]; then
        mkdir -p "$backup_dir"
        cp -p "$target" "$original"
    fi

    old_size=$(stat -c %s "$original")
    new_size=$(stat -c %s "$source")
    if (( new_size > old_size )); then
        if [[ "$IS_RU" == true ]]; then
            echo "❌ Ошибка: пропатченная SDL больше оригинала ($directory)."
        else
            echo "❌ Error: patched SDL is larger than the original ($directory)."
        fi
        return 1
    fi

    if [[ -f "$shim" && ! -f "$backup_dir/sdl3_shim.so" ]] && ! cmp -s "$shim" "$shim_source"; then
        cp -p "$shim" "$backup_dir/sdl3_shim.so"
    fi

    # Keep the in-place copy and size-truncation behavior used by the original installer.
    cp "$source" "$target"
    truncate -s "$old_size" "$target"
    sudo install -m 0644 "$shim_source" "$shim" 2>/dev/null || true
    sha256sum "$target" | cut -d ' ' -f 1 > "$state"
    echo " -> Patching $directory..."
}

patch_sdl() {
    if [[ "$IS_RU" == true ]]; then
        echo "📦 Обновление библиотек SDL3 в Steam..."
    else
        echo "📦 Updating SDL3 libraries in Steam..."
    fi
    if [[ ! -d "$DRIVER_DIR" ]]; then
        if [[ "$IS_RU" == true ]]; then
            echo "❌ Ошибка: папка с собранным драйвером $DRIVER_DIR не найдена!"
        else
            echo "❌ Error: driver directory $DRIVER_DIR not found!"
        fi
        exit 1
    fi
    if pgrep -x steamwebhelper >/dev/null || pgrep -x steam >/dev/null; then
        if [[ "$IS_RU" == true ]]; then
            echo "❌ Ошибка: полностью закройте Steam перед обновлением SDL3."
        else
            echo "❌ Error: close Steam completely before updating SDL3."
        fi
        exit 1
    fi

    # The legacy updater stored the pre-patch file size in-place. Recover the
    # original stock files once before switching to backups outside Steam.
    if [[ ! -f "$DRIVER_DIR/originals/steamrt64/libSDL3.so.0" && -f "$STEAM_DIR/steamrt64/libSDL3.so.0.vader5-original" ]]; then
        mkdir -p "$DRIVER_DIR/originals/steamrt64"
        cp -p "$STEAM_DIR/steamrt64/libSDL3.so.0.vader5-original" "$DRIVER_DIR/originals/steamrt64/libSDL3.so.0"
        rm -f "$STEAM_DIR/steamrt64/libSDL3.so.0.vader5-original"
    fi
    if [[ ! -f "$DRIVER_DIR/originals/ubuntu12_64/libSDL3.so.0" && -f "$STEAM_DIR/ubuntu12_64/libSDL3.so.0.vader5-original" ]]; then
        mkdir -p "$DRIVER_DIR/originals/ubuntu12_64"
        cp -p "$STEAM_DIR/ubuntu12_64/libSDL3.so.0.vader5-original" "$DRIVER_DIR/originals/ubuntu12_64/libSDL3.so.0"
        rm -f "$STEAM_DIR/ubuntu12_64/libSDL3.so.0.vader5-original"
    fi

    patch_one 64 ubuntu12_64
    if [[ -f "$DRIVER_DIR/32-bit-build.enabled" ]]; then
        patch_one 32 ubuntu12_32
    fi
    patch_one 64 steamrt64

    if [[ "$IS_RU" == true ]]; then
        echo "✅ Готово! Патч применён."
    else
        echo "✅ Done! Patch applied."
    fi
}

mode_native() {
    if [[ "$IS_RU" == true ]]; then
        echo "🎮 Переключаемся в STEAM NATIVE..."
    else
        echo "🎮 Switching to STEAM NATIVE..."
    fi
    [[ -f "$RULE" ]] || {
        if [[ "$IS_RU" == true ]]; then echo "❌ Не найдено $RULE. Запустите ./install.sh"; else echo "❌ Missing $RULE. Run ./install.sh"; fi
        exit 1
    }
    systemctl --user disable --now padctl 2>/dev/null || true
    reload_udev
    systemctl --user --quiet enable --now vader5-rumble
    if [[ "$IS_RU" == true ]]; then
        echo "✅ Режим STEAM NATIVE активен. Вытащи и вставь USB-донгл."
    else
        echo "✅ STEAM NATIVE mode active. Unplug and replug the USB dongle."
    fi
}

mode_padctl() {
    if [[ "$IS_RU" == true ]]; then
        echo "🕹️ Переключаемся в PADCTL (Виртуальный Xbox Elite)..."
    else
        echo "🕹️ Switching to PADCTL (Virtual Xbox Elite)..."
    fi
    systemctl --user disable --now vader5-rumble 2>/dev/null || true
    reload_udev
    systemctl --user --quiet enable --now padctl
    if [[ "$IS_RU" == true ]]; then
        echo "✅ Режим PADCTL активен. Вытащи и вставь USB-донгл."
    else
        echo "✅ PADCTL mode active. Unplug and replug the USB dongle."
    fi
}

show_status() {
    if systemctl --user is-active --quiet padctl 2>/dev/null; then
        if [[ "$IS_RU" == true ]]; then echo "Текущий режим: 🕹️ PADCTL (Виртуальный Xbox Elite)"; else echo "Current mode: 🕹️ PADCTL (Virtual Xbox Elite)"; fi
    else
        if [[ "$IS_RU" == true ]]; then echo "Текущий режим: 🎮 STEAM NATIVE (Пропатченный SDL3)"; else echo "Current mode: 🎮 STEAM NATIVE (Patched SDL3)"; fi
    fi
}

case "${1:-status}" in
    n|native) mode_native ;;
    p|padctl) mode_padctl ;;
    u|update) patch_sdl ;;
    s|status) show_status ;;
    *)
        if [[ "$IS_RU" == true ]]; then
            echo "Использование: vader5 [native|padctl|update|status]"
            echo "               vader5 [n|p|u|s]"
        else
            echo "Usage: vader5 [native|padctl|update|status]"
            echo "       vader5 [n|p|u|s]"
        fi
        show_status
        ;;
esac
