#!/usr/bin/env bash
set -euo pipefail
RULE=/etc/udev/rules.d/60-vader5-sdl.rules
DRIVER_DIR="${VADER5_DRIVER_DIR:-$HOME/.local/share/vader5-driver/sdl}"
STEAM_DIR="${VADER5_STEAM_DIR:-$HOME/.local/share/Steam}"
reload_udev() {
    sudo udevadm control --reload-rules
    local interface parent
    for interface in /sys/bus/usb/drivers/xpad/*:1.0; do
        [[ -L "$interface" ]] || continue
        parent=$(dirname "$(readlink -f "$interface")")
        if [[ "$(cat "$parent/idVendor" 2>/dev/null)" == 37d7 && "$(cat "$parent/idProduct" 2>/dev/null)" == 2401 ]]; then
            printf '%s' "${interface##*/}" | sudo tee /sys/bus/usb/drivers/xpad/unbind >/dev/null
        fi
    done
    echo 'Reconnect the USB dongle to apply the new mode.'
}
patch_one() {
    local arch="$1" directory="$2" source
    source="$DRIVER_DIR/libSDL3-$arch.so.0"
    local target="$STEAM_DIR/$directory/libSDL3.so.0" shim="$STEAM_DIR/$directory/sdl3_shim.so"
    [[ -f "$target" ]] || return 0
    [[ -f "$source" ]] || { echo "Skipping $directory: no $source" >&2; return 0; }
    [[ -f "$shim" ]] || { echo "Skipping $directory: missing Steam sdl3_shim.so" >&2; return 0; }
    local original="$target.vader5-original" state="$DRIVER_DIR/$directory.last-patch.sha256"
    local old_size new_size temp current_hash
    current_hash=$(sha256sum "$target")
    current_hash=${current_hash%% *}
    if [[ ! -f "$original" || ( -f "$state" && "$current_hash" != "$(cat "$state")" ) ]]; then
        cp -p "$target" "$original"
    fi
    old_size=$(stat -c %s "$original")
    new_size=$(stat -c %s "$source")
    (( new_size <= old_size )) || { echo "Skipping $directory: patched SDL is larger than stock SDL" >&2; return 1; }
    temp=$(mktemp "$STEAM_DIR/$directory/.libSDL3.vader5.XXXXXX")
    trap 'rm -f "$temp"' RETURN
    cp "$source" "$temp"
    truncate -s "$old_size" "$temp"
    chmod --reference="$target" "$temp"
    mv -f "$temp" "$target"
    sha256sum "$target" | cut -d ' ' -f 1 > "$state"
    trap - RETURN
    echo "Patched $directory ($new_size bytes, padded to $old_size)."
}
patch_sdl() {
    [[ -d "$DRIVER_DIR" ]] || { echo "Build first: ./build.sh" >&2; exit 1; }
    if pgrep -x steamwebhelper >/dev/null || pgrep -x steam >/dev/null; then
        echo 'Close Steam completely before updating its SDL libraries.' >&2
        exit 1
    fi
    patch_one 64 steamrt64
    patch_one 64 ubuntu12_64
    patch_one 32 ubuntu12_32
}
mode_native() {
    [[ -f "$RULE" ]] || { echo "Missing $RULE; run ./install.sh" >&2; exit 1; }
    systemctl --user stop padctl 2>/dev/null || true
    systemctl --user start vader5-rumble
    reload_udev
    echo 'Steam native mode active.'
}
mode_padctl() {
    systemctl --user stop vader5-rumble 2>/dev/null || true
    systemctl --user start padctl
    reload_udev
    echo 'Padctl mode active.'
}
show_status() {
    if systemctl --user is-active --quiet padctl; then
        echo 'Mode: padctl'
    elif systemctl --user is-active --quiet vader5-rumble; then
        echo 'Mode: Steam native, Xbox rumble bridge active'
    else
        echo 'Mode: neither service active'
    fi
}
case "${1:-status}" in
    n|native) mode_native ;;
    p|padctl) mode_padctl ;;
    u|update) patch_sdl ;;
    s|status) show_status ;;
    *) echo 'Usage: vader5 {native|padctl|update|status}' >&2; exit 2 ;;
esac
